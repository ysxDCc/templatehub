# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Dodo Payments Gateway
DODO_PAYMENTS_API_KEY=your_dodo_api_key
DODO_PAYMENTS_ENVIRONMENT=live_mode
DODO_PAYMENTS_WEBHOOK_KEY=your_webhook_signing_key

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Contact forms (https://resend.com) — verify your domain in Resend first
RESEND_API_KEY=re_your_resend_api_key
FORMS_FROM_EMAIL=TemplateHub Forms <forms@templatehub.website>

# Optional: AI Studio (Google Gemini) — only used for signed-in users
GEMINI_API_KEY=
